{
  "name": "homehuddle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go --lan",
    "start:go:tunnel": "expo start --go --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:simulator": "node scripts/ios-simulator.mjs",
    "start:simulator": "expo start --dev-client --localhost",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-database-embedded.mjs",
    "test:db:native": "node scripts/test-database.mjs",
    "lint:production": "eslint features/chores features/household features/meals features/planning features/rewards features/shopping components/ui --max-warnings=0",
    "export:web": "expo export --platform web",
    "check:env": "node --env-file-if-exists=.env scripts/check-environment.mjs",
    "check:source": "node scripts/check-source-hygiene.mjs",
    "check:edge": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/billing-reconcile/index.ts supabase/functions/billing-webhook/index.ts",
    "check": "npm run typecheck && npm run test && npm run test:db && npm run lint && npm run lint:production && npm run check:source"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.98.0",
    "base64-arraybuffer": "^1.0.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.25",
    "expo-apple-authentication": "~57.0.2",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^0.575.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-css-interop": "^0.2.7",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.74",
    "react-native-purchases": "^10.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@electric-sql/pglite": "0.5.8",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true
