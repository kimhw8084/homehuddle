{
  "expo": {
    "name": "HomeHuddle",
    "slug": "HomeHuddle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homehuddle",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.harulo.homehuddle",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "HomeHuddle needs camera access to take before & after photos for chores.",
        "NSPhotoLibraryUsageDescription": "HomeHuddle needs photo library access to attach photos to chores.",
        "NSPhotoLibraryAddUsageDescription": "HomeHuddle needs permission to save photos to your library."
      }
    },
    "android": {
      "package": "com.harulo.homehuddle",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeHuddle needs access to your photos to attach before & after photos to chores.",
          "cameraPermission": "HomeHuddle needs camera access to take before & after photos for chores."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
