# Public values only. Use the project's publishable key, never a secret/service role key.
EXPO_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# A legacy EXPO_PUBLIC_SUPABASE_ANON_KEY is supported during key migration.
# Billing and push delivery are NOT enabled by setting frontend keys alone.
EXPO_PUBLIC_BILLING_ENABLED=false
# Enable only after server functions, store products, legal pages and sandbox QA.
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_PUBLIC_SDK_KEY
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_PUBLIC_SDK_KEY
# EXPO_PUBLIC_TERMS_URL=https://YOUR_DOMAIN/terms
# EXPO_PUBLIC_PRIVACY_URL=https://YOUR_DOMAIN/privacy
