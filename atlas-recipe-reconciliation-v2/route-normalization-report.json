  "function_name": "normalize_route_evidence",
  "function_spec_python": "def normalize_route_evidence(actual_url, expected_route, query_policy, ready_passed):\n    actual = urlsplit(actual_url); expected = urlsplit(expected_route)\n    canonical_path = lambda p: \"/\" if not p or p == \"/\" else p\n    pathname_passed = canonical_path(actual.path) == canonical_path(expected.path)\n    if not expected.query: query_passed = not actual.query\n    elif query_policy == \"preserved\": query_passed = actual.query == expected.query\n    elif query_policy == \"consumed\": query_passed = bool(ready_passed)\n    else: query_passed = False  # fail closed\n    return pathname_passed and query_passed",
