{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["expo/types", "jest", "node", "react"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "exclude": ["supabase/functions", "node_modules"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
